# 复制为 .env 并填入自己的密钥。.env 已被 .gitignore 排除，绝不提交。

# ── LLM（Anthropic 协议兼容服务，示例为 DeepSeek）──────────────────────────
ANTHROPIC_API_KEY=sk-your_api_key_here
ANTHROPIC_MODEL=deepseek-chat
# 也可换阿里云百炼: https://dashscope.aliyuncs.com/apps/anthropic (模型 qwen-plus-latest)
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=creditlife123
REDIS_URL=redis://:creditlife123@redis:6379/0

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 知识库种子目录（业务语料与代码分离）───────────────────────────────────────
KNOWLEDGE_SEED_DIR=/app/data/demo_docs

# ── 评测 ──────────────────────────────────────────────────────────────────────
# Judge 可独立配置模型（默认与对话同模型）
EVAL_JUDGE_MODEL=

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
